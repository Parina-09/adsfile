                      classification_models.keys()] +
                     [regression_models[name]['training_time'] for name in regression_models.keys()])
        bars = ax3.bar(all_models, all_times,
                       color=['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FECA57'], alpha=0.8)
